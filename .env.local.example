# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get anon key from: https://supabase.com/dashboard/project/rvublstbxstwpqjfgmfb/settings/api

VITE_SUPABASE_URL=https://rvublstbxstwpqjfgmfb.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STAGE_MODE_AVAILABLE=true
# Stage / Live mode — for projecting visualizations at venues (reacts to mic/line-in)
# Set to "true" to enable /stage. When unset or false, /stage redirects to home.
# Not linked from the main site; for band use only.
# VITE_STAGE_MODE_AVAILABLE=true
